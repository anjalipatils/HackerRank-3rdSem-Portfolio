#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, q;
    if (scanf("%d %d", &n, &q) != 2) return 0;

    int* arr[n];
    int size[n];
    int capacity[n];

    for (int i = 0; i < n; i++) {
        size[i] = 0;
        capacity[i] = 2;
        arr[i] = (int*)malloc(capacity[i] * sizeof(int));
    }

    int lastAnswer = 0;

    for (int k = 0; k < q; k++) {
        int type, x, y;
        scanf("%d %d %d", &type, &x, &y);

        int idx = (x ^ lastAnswer) % n;

        if (type == 1) {
            if (size[idx] == capacity[idx]) {
                capacity[idx] *= 2;
                arr[idx] = (int*)realloc(arr[idx], capacity[idx] * sizeof(int));
            }
            arr[idx][size[idx]++] = y;
        } else if (type == 2) {
            int element_idx = y % size[idx];
            lastAnswer = arr[idx][element_idx];
            printf("%d\n", lastAnswer);
        }
    }

    for (int i = 0; i < n; i++) free(arr[i]);

    return 0;
}
